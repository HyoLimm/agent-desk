{
  "name": "agent-desk",
  "version": "0.1.14",
  "description": "Claude Code 세션과 하위 에이전트가 지금 무엇을 하는지, 책상에 앉은 픽셀 감자 직장인이 보여 줍니다. Windows 전용.",
  "license": "MIT",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "cmd", "args": ["/d", "/c", "${CLAUDE_PLUGIN_ROOT}\\scripts\\check_python.cmd"], "timeout": 10 } ] },
      { "hooks": [ { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_desk.py\" hook", "timeout": 5, "async": true } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_desk.py\" hook", "timeout": 5, "async": true } ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_desk.py\" hook", "timeout": 5, "async": true } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_desk.py\" hook", "timeout": 5, "async": true } ] }
    ],
    "PostToolUseFailure": [
      { "hooks": [ { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_desk.py\" hook", "timeout": 5, "async": true } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_desk.py\" hook", "timeout": 5, "async": true } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_desk.py\" hook", "timeout": 5, "async": true } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_desk.py\" hook", "timeout": 5, "async": true } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_desk.py\" hook", "timeout": 5, "async": true } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_desk.py\" hook", "timeout": 5, "async": true } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/agent_desk.py\" hook", "timeout": 5, "async": true } ] }
    ]
  }
}
